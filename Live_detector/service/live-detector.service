[Unit]
Description=BirdSong Observatory - Live Detector Edge Agent
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Live_detector
EnvironmentFile=/home/pi/Live_detector/.env
ExecStart=/home/pi/Live_detector/venv/bin/python3 /home/pi/Live_detector/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SupplementaryGroups=audio video

[Install]
WantedBy=multi-user.target
