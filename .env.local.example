# Supabase Cloud Project Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"
# Server-side Resend API key (kept secret, used in /api/send-otp)
RESEND_API_KEY=re_your_resend_api_key_here
# Sender address - must be a verified domain in Resend
FROM_EMAIL=BirdSong Observatory <noreply@contact.birdsongobservatory.in>
